{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "window-state:default",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
